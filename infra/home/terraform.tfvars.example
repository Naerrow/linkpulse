# `terraform.tfvars`로 복사해 채운다(실제 tfvars는 .gitignore). 값은 런북 home-site.md 0단계(공유기·Proxmox 확인)에서 정한다.
# Proxmox API 토큰은 여기에 쓰지 않는다 — 환경 변수 PROXMOX_VE_API_TOKEN으로만 준다.

proxmox_endpoint = "https://192.168.0.10:8006/"
node_name        = "pve"

# 공유기 주소와 DHCP 범위 밖의 두 주소.
gateway = "192.168.0.1"
k3s_ip  = "192.168.0.50"
pg_ip   = "192.168.0.51"

# 기본값과 다를 때만 적는다.
# image_datastore_id  = "local"      # 허용 콘텐츠에 Import가 있어야 한다
# vm_datastore_id     = "local-lvm"
# network_bridge      = "vmbr0"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
