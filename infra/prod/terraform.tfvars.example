# `terraform.tfvars`로 복사해 환경값을 채운다(실제 tfvars는 .gitignore). 비밀값은 넣지 않는다.

# 도메인(이미 Route53에 있는 호스팅 영역).
domain_name = "lpulse.live"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"  # 동일 이름 zone이 여러 개일 때만 지정

# 앱 설정(관리자 토큰 해시·레이트리밋 예외·LOG_LEVEL 등)은 이 스택이 아니라 infra/k8s가 클러스터 안에 넣는다
# (plan 0014). 관리자 토큰 해시는 infra/k8s/terraform.tfvars에 둔다(infra/k8s/terraform.tfvars.example).

# 비용/사양 조정 예시(기본값으로도 동작).
# db_instance_class  = "db.t4g.micro"
# eks_version        = "1.37"        # apply 전 aws eks describe-cluster-versions로 표준 지원인지 확인
# node_instance_type = "t4g.medium"
# node_count         = 2

# ---- 모니터링 / Slack 알림 (P3) ----
# Slack 통지: AWS 콘솔 "Amazon Q Developer in chat applications"에서 workspace를 OAuth 승인한 뒤
# team/channel ID를 넣는다(둘 다 필수 — 한쪽만 넣으면 apply 전 validation 에러). 채널 ID는 채널명이 아니라
# 우클릭→링크 복사 끝의 문자열(예: C0123ABCDEF). 승인 후 Slack 채널에서 `/invite @Amazon Q` 실행 필요.
# 준비 전이면 둘 다 비워 알람+SNS만 먼저 apply한다(Slack 배선 스킵).
# slack_team_id    = "T0123ABCD"
# slack_channel_id = "C0123ABCDEF"

# ---- 알람 SMS (2026-08-30 장애 A-1b) ----
# Slack 카드는 도착했는데 사람에게 닿지 않아 118시간 갔다. Slack 앱 설정과 독립된 두 번째 경로.
# E.164 형식(국가번호 포함, 하이픈 없음). 비우면 SMS 구독을 만들지 않는다.
#
# ⚠️ apply 전에 SNS SMS 샌드박스를 먼저 확인한다. 샌드박스 상태면 "검증된 번호"에만 발송되므로
#    구독은 만들어져도 문자가 오지 않는다(조용히 실패한다):
#      aws sns get-sms-sandbox-account-status --region ap-northeast-2
#      aws sns create-sms-sandbox-phone-number --phone-number +8210XXXXXXXX --region ap-northeast-2
#      aws sns verify-sms-sandbox-phone-number --phone-number +8210XXXXXXXX --one-time-password 123456 --region ap-northeast-2
#    us-east-1 토픽도 쓰므로 **두 리전 각각** 확인·검증한다(샌드박스 상태는 리전별이다).
# ⚠️ 이 값은 tfstate에 평문으로 남는다(S3 백엔드). 개인 번호이므로 감수 여부를 판단하고 쓴다.
# alarm_sms_number = "+8210XXXXXXXX"
